# Copy to .env and adjust. Placeholder values only; never commit a real .env.
NODE_ENV=development
PORT=3000

POSTGRES_USER=resourcehub
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=resourcehub

# Local `npm run dev` uses localhost; docker compose overrides the host to `db`.
DATABASE_URL=postgresql://resourcehub:change-me-local-only@localhost:5432/resourcehub
